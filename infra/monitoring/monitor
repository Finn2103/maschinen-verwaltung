# Führt genau ein Prüfmodul im eigenen Arbeitsordner aus
collect() {
  local name=${1:?Modulname fehlt}
  [[ " $MODULES " == *" $name "* ]] || die "unbekanntes Prüfmodul: $name (vorhanden: $MODULES)"
  MONITOR_WORK="${MONITOR_WORK:-$WORK_DIR}/$name"
  mkdir -p "$MONITOR_WORK" || die "kann $MONITOR_WORK nicht anlegen"
  "check_$name"
}

# Startet alle aktivierten Module parallel mit Zeitlimit und schreibt status.json atomar
run_cycle() {
  local target=$1 dir t0 c rc
  dir=$(mktemp -d -p "$WORK_DIR" cycle.XXXXXX) || return 1
  t0=$(now_ms)
  local -A pids=()

  for c in $CHECKS; do
    MONITOR_WORK="$dir" timeout -k 2 "$COLLECT_TIMEOUT" "$SELF" _collect "$c" \
      >"$dir/$c.jsonl" 2>"$dir/$c.err" &
    pids[$c]=$!
  done
  for c in "${!pids[@]}"; do
    wait "${pids[$c]}"; rc=$?
    if (( rc == 124 || rc == 137 )); then
      emit "monitor/$c" monitor "$c" ERROR timeout \
        "Prüfmodul $c hat das Zeitlimit von ${COLLECT_TIMEOUT} s überschritten" >>"$dir/$c.jsonl"
    elif (( rc != 0 )); then
      emit "monitor/$c" monitor "$c" ERROR failed \
        "Prüfmodul $c ist mit Fehler $rc abgebrochen" \
        "$(jq -nc --arg e "$(tail -c 500 "$dir/$c.err")" '{stderr:$e}')" >>"$dir/$c.jsonl"
    fi
  done

  local ms=$(( $(now_ms) - t0 ))
  cat "$dir"/*.jsonl 2>/dev/null | jq -cR 'fromjson? | select(type == "object" and has("id"))' |
    jq -s --arg host "$(hostname)" --arg time "$(date -Iseconds)" \
      --argjson epoch "$(date +%s)" --argjson ms "$ms" --argjson interval "$INTERVAL" \
      --arg version "$VERSION" "$JQ_SNAPSHOT" >"$target.tmp" &&
    mv -f "$target.tmp" "$target"
  rm -rf "$dir"
}

# === 7. Spam-Schutz (Zustand ausschließlich in RAM-Variablen) ===

declare -A NOTIFIED=() PENDING=() PCOUNT=() NLOG=() SUPPRESSED=()
CHANGES='[]'

# Entscheidet nach Bestätigungszahl und Zeitfenster, welche Änderungen gemeldet werden (Entwarnung & Verschlechterung immer sofort)
decide_changes() {
  local file=$1 now id lvl n prev
  now=$(date +%s)
  local -A seen=()
  local out=()

  while IFS=$'\t' read -r id lvl; do
    seen[$id]=1
    n=${LEVEL_NUM[$lvl]:-0}
    prev=${NOTIFIED[$id]:-0}

    if (( n == prev )); then
      PENDING[$id]=""; PCOUNT[$id]=0
      continue
    fi
    if [[ ${PENDING[$id]:-} == "$n" ]]; then
      PCOUNT[$id]=$(( ${PCOUNT[$id]:-0} + 1 ))
    else
      PENDING[$id]=$n; PCOUNT[$id]=1
    fi
    (( PCOUNT[$id] >= CONFIRM_CYCLES )) || continue

    local entry kept="" count=0 maxlvl=-1 t l
    for entry in ${NLOG[$id]:-}; do
      t=${entry%%:*}; l=${entry##*:}
      if (( now - t < NOTIFY_WINDOW )); then
        kept+="$entry "; count=$(( count + 1 )); (( l > maxlvl )) && maxlvl=$l
      fi
    done
    NLOG[$id]=$kept

    if (( count >= NOTIFY_MAX && n <= maxlvl && !(n == 0 && prev > 0) )); then
      if (( PCOUNT[$id] == CONFIRM_CYCLES )); then
        SUPPRESSED[$id]=$(( ${SUPPRESSED[$id]:-0} + 1 ))
        log INFO "$id: Wechsel zu ${LEVEL_NAMES[$n]} unterdrückt (Spam-Schutz, $count Meldungen in ${NOTIFY_WINDOW} s)"
      fi
      continue
    fi

    out+=("$(jq -nc --arg id "$id" --argjson p "$prev" --argjson s "${SUPPRESSED[$id]:-0}" \
               '{id:$id, previous:$p, suppressed:$s, gone:false}')")
    NOTIFIED[$id]=$n
    NLOG[$id]+="$now:$n "
    SUPPRESSED[$id]=0
    PENDING[$id]=""; PCOUNT[$id]=0
  done < <(jq -r '.checks[] | [.id, .level] | @tsv' "$file")

  for id in "${!NOTIFIED[@]}"; do
    [[ -n ${seen[$id]:-} ]] && continue
    if (( ${NOTIFIED[$id]} > 0 )); then
      out+=("$(jq -nc --arg id "$id" --argjson p "${NOTIFIED[$id]}" \
                 '{id:$id, previous:$p, suppressed:0, gone:true}')")
    fi
    unset 'NOTIFIED[$id]' 'PENDING[$id]' 'PCOUNT[$id]' 'NLOG[$id]' 'SUPPRESSED[$id]'
  done

  if (( ${#out[@]} == 0 )); then CHANGES='[]'
  else CHANGES=$(printf '%s\n' "${out[@]}" | jq -sc '.'); fi
}

