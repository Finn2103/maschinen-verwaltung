        ] + (if ($m.problems | length) > 0 then
              [{name: "Offene Probleme", inline: false,
                value: ([$m.problems[] | "\(.level | icon) \(.message)"] | join("\n") | cut(1000))}]
             else [] end)),
        footer: {text: "monitor · Durchlauf \($m.cycle_ms) ms"}
      }]
    }
  elif $m.type == "test" then
    {username: "Monitor \($m.host)",
     embeds: [{title: "🔔 Testmeldung von \($m.host)", description: $m.message, color: 3447003, timestamp: $m.time}]}
  else
    $m.events as $ev
    | {
        username: "Monitor \($m.host)",
        content: (if $m.level == "INFO" then "Entwarnung auf **\($m.host)**"
                  else "\($m.level | icon) **\($m.level)** auf **\($m.host)**" end),
        embeds: (
          [ $ev[0:3][] | {
              title: ("\(.level | icon) \(.level) · \(.id)" | cut(200)),
              description: ((.message
                + "\nvorher \(.previous_level), jetzt \(.level)"
                + (if .suppressed_changes > 0 then "\n\(.suppressed_changes) Wechsel dazwischen unterdrückt (Spam-Schutz)" else "" end))
                | cut(400)),
              color: (.level | color),
              fields: fields(.details; 7),
              timestamp: $m.time,
              footer: {text: "\($m.host) · \(.kind) · \(.status)"}
            } ]
          + (if ($ev | length) > 3 then
              [{ title: "Weitere \(($ev | length) - 3) Änderungen",
                 color: ($m.level | color),
                 description: ([$ev[3:][] | "\(.level | icon) \(.message)"] | join("\n") | cut(1200)) }]
             else [] end)
        )
      }
  end
JQ

build_event()  { jq -c --argjson changes "$2" "$JQ_EVENT" "$1"; }
build_report() { jq -c "$JQ_REPORT" "$1"; }

# Filtert eine Meldung je Webhook nach Event-Typ/Mindeststufe und startet den Versand im Hintergrund
notify() {
  local doc=$1 type count i hook name htype url min ok_ev headers payload file
  type=$(jq -r '.type' <<<"$doc")
  count=$(jq 'length' <<<"$WEBHOOKS" 2>/dev/null) || { log ERROR "WEBHOOKS ist kein gültiges JSON"; return 1; }
  for (( i = 0; i < count; i++ )); do
    hook=$(jq -c ".[$i]" <<<"$WEBHOOKS")
    {
      IFS= read -r name; IFS= read -r htype; IFS= read -r url
      IFS= read -r min; IFS= read -r ok_ev; IFS= read -r headers
    } < <(jq -r --arg t "$type" '
      (.name // "webhook-\(.type)"), (.type // "json"), (.url // ""), (.min_level // "WARNING"),
      (if $t == "test" or ((.events // ["change","report"]) | index($t) != null) then "1" else "0" end),
      ((.headers // {}) | tojson)' <<<"$hook")

    [[ -n $url ]] || { log WARNING "Webhook $name hat keine url"; continue; }
    [[ $ok_ev == 1 ]] || continue

    if [[ $type == change ]]; then
      payload=$(jq -c --argjson m "${LEVEL_NUM[$min]:-0}" '
        def lnum: {"INFO":0,"WARNING":1,"ERROR":2,"CRITICAL":3}[.] // 0;
        def lname: ["INFO","WARNING","ERROR","CRITICAL"][.];
        .events |= map(select(([(.level | lnum), (.previous_level | lnum)] | max) >= $m))
        | .level = ([.events[].level | lnum] | max // 0 | lname)' <<<"$doc")
      [[ $(jq '.events | length' <<<"$payload") -gt 0 ]] || continue
    else
      payload=$doc
    fi

    case $htype in
      discord) payload=$(jq -c "$JQ_DISCORD" <<<"$payload") ;;
      json)    ;;
      *)       log WARNING "Webhook $name: unbekannter Typ $htype, sende JSON" ;;
    esac

    file=$(mktemp -p "$RUN_DIR/outbox" "msg.XXXXXX") || continue
    printf '%s' "$payload" >"$file"
    deliver "$name" "$url" "$headers" "$file" "$type" &
  done
}

# Stellt eine Meldung per HTTP-POST mit exponentiellem Backoff zu
deliver() {
  local name=$1 url=$2 headers=$3 file=$4 type=$5 h try code wait=2
  local -a args=(-sS -o /dev/null -w '%{http_code}' -m 10 -X POST
                 -H 'Content-Type: application/json' --data-binary "@$file")
  while IFS= read -r h; do [[ -n $h ]] && args+=(-H "$h"); done \
    < <(jq -r 'to_entries[] | "\(.key): \(.value)"' <<<"$headers")

  for (( try = 1; try <= DELIVERY_RETRIES; try++ )); do
    code=$(curl "${args[@]}" "$url" 2>/dev/null)
    if [[ $code == 2* ]]; then
      log INFO "Meldung ($type) an $name zugestellt (HTTP $code, Versuch $try)"
      rm -f "$file"; return 0
    fi
    [[ $code == 429 ]] && wait=$(( wait * 3 ))
    (( try < DELIVERY_RETRIES )) && sleep "$wait"
    wait=$(( wait * 2 ))
  done
  log ERROR "Meldung ($type) an $name nicht zugestellt (zuletzt HTTP ${code:-keine Antwort}, $DELIVERY_RETRIES Versuche)"
  rm -f "$file"; return 1
}

# === 9. Betriebsbefehle (run, status, check, report, test-webhook, validate) ===

# Hauptschleife des systemd-Dienstes: prüft im Takt, meldet Änderungen und sendet Berichte
cmd_run() {
  (( EUID == 0 )) || log WARNING "läuft ohne root, Docker-Socket und Dienste evtl. nicht lesbar"
  ensure_dirs
  rm -f "$RUN_DIR"/outbox/msg.* 2>/dev/null
  trap 'log INFO "monitor beendet"; exit 0' TERM INT
  log INFO "monitor $VERSION gestartet: alle $INTERVAL s, Module: $CHECKS, $(jq length <<<"$WEBHOOKS") Webhook(s)"

  local last_report=0 first=1 t0 elapsed doc
  while true; do
    t0=$(date +%s)
    if run_cycle "$STATUS_FILE"; then
      decide_changes "$STATUS_FILE"
      if [[ $CHANGES != '[]' ]]; then
        doc=$(build_event "$STATUS_FILE" "$CHANGES")
        jq -r '.events[] | "\(.level)\t\(.id): \(.message) (vorher \(.previous_level))"' <<<"$doc" |
          while IFS=$'\t' read -r lvl text; do log "$lvl" "$text"; done
        notify "$doc"
      fi
      if (( REPORT_INTERVAL > 0 )); then
        if (( (first && REPORT_ON_START) || (!first && t0 - last_report >= REPORT_INTERVAL) )); then
          notify "$(build_report "$STATUS_FILE")"; last_report=$t0
        fi
        (( first && !REPORT_ON_START )) && last_report=$t0
      fi
      first=0
    else
      log ERROR "Durchlauf fehlgeschlagen"
    fi
    elapsed=$(( $(date +%s) - t0 ))
    if (( elapsed < INTERVAL )); then
      sleep $(( INTERVAL - elapsed )) &
      wait $! 2>/dev/null
    fi
  done
}

# Zeigt den letzten Zustand als Tabelle oder JSON; Exit-Code = höchste Stufe (0..3, 4 = veraltet/aus)
cmd_status() {
  local mode=table epoch level age
  case ${1:-} in
    --json) mode=json ;; --problems) mode=problems ;; "") ;;
    *) die "unbekannte Option: $1" ;;
  esac
  if [[ ! -s $STATUS_FILE ]]; then
    echo "Kein Zustand in $STATUS_FILE. Läuft der Dienst? systemctl status monitor" >&2
    exit 4
  fi
  read -r epoch level < <(jq -r '[.epoch, .level] | @tsv' "$STATUS_FILE")
  age=$(( $(date +%s) - epoch ))
  if [[ $mode == json ]]; then jq --argjson age "$age" '. + {age_seconds: $age}' "$STATUS_FILE"
  else print_table "$STATUS_FILE" "$mode" "$age"; fi
  if (( age > 3 * INTERVAL + COLLECT_TIMEOUT )); then
    echo "ACHTUNG: Zustand ist $age s alt, der Dienst prüft nicht mehr. systemctl status monitor" >&2
    exit 4
  fi
  exit "${LEVEL_NUM[$level]:-0}"
}

# Führt sofort genau eine Prüfung ohne Meldungen aus (nützlich beim Testen der Konfiguration)
cmd_check() {
  local mode=table level
  [[ ${1:-} == --json ]] && mode=json
  WORK_DIR=$(mktemp -d -p /dev/shm monitor-check.XXXXXX) || die "kein Platz in /dev/shm"
  trap 'rm -rf "$WORK_DIR"' EXIT
  run_cycle "$WORK_DIR/status.json" || die "Prüfung fehlgeschlagen"
  if [[ $mode == json ]]; then jq . "$WORK_DIR/status.json"
  else print_table "$WORK_DIR/status.json" table 0; fi
  level=$(jq -r .level "$WORK_DIR/status.json")
  exit "${LEVEL_NUM[$level]:-0}"
}

# Sendet sofort einen Statusbericht an alle passenden Webhooks
cmd_report() {
  ensure_dirs
  [[ -s $STATUS_FILE ]] || run_cycle "$STATUS_FILE"
  notify "$(build_report "$STATUS_FILE")"
  wait
}

# Sendet eine Testmeldung an alle oder einen benannten Webhook
cmd_test_webhook() {
  ensure_dirs
  local only=${1:-}
  if [[ -n $only ]]; then
    WEBHOOKS=$(jq -c --arg n "$only" 'map(select(.name == $n))' <<<"$WEBHOOKS")
    [[ $(jq length <<<"$WEBHOOKS") -gt 0 ]] || die "Webhook $only nicht gefunden"
  fi
  LOG_LEVEL=INFO
  notify "$(jq -nc --arg h "$(hostname)" --arg t "$(date -Iseconds)" \
    '{schema:"monitor.event/v1", type:"test", host:$h, time:$t, level:"INFO",
      message:"Testmeldung: Der Webhook ist richtig eingerichtet.", events:[]}')"
  wait
}

# Prüft Werkzeuge, JSON-Syntax, Pflichtfelder, Zugangsdaten-Warnung und Docker-Socket
cmd_validate() {
  local ok=0 c
  for c in bash curl jq awk df ps timeout systemctl; do
    command -v "$c" >/dev/null || { echo "FEHLT: $c"; ok=1; }
  done
  jq -e 'type == "array"' <<<"$WEBHOOKS" >/dev/null 2>&1 || { echo "FEHLER: WEBHOOKS ist keine JSON-Liste"; ok=1; }
  jq -e 'type == "array"' <<<"$ENDPOINTS" >/dev/null 2>&1 || { echo "FEHLER: ENDPOINTS ist keine JSON-Liste"; ok=1; }
  jq -e 'all(.[]; (.type // "json") as $t | ["json","discord"] | index($t) != null) and all(.[]; .url != null)' \
    <<<"$WEBHOOKS" >/dev/null 2>&1 || { echo "FEHLER: jeder Webhook braucht url und type json oder discord"; ok=1; }
  jq -e 'all(.[]; (.type // (if has("port") then "tcp" else "http" end)) as $t
           | ($t == "http" and .url != null)
             or (($t | IN("tcp", "postgres", "smtp", "imap")) and .port != null))' <<<"$ENDPOINTS" >/dev/null 2>&1 ||
    { echo "FEHLER: jeder Endpoint braucht url (http) oder port (tcp, postgres, smtp, imap)"; ok=1; }
  if grep -qiE 'passw|pgpass|apikey|token|secret' <<<"$ENDPOINTS"; then
    echo "HINWEIS: ENDPOINTS scheint Zugangsdaten zu enthalten. monitor braucht keine, siehe SKILL.md"
  fi
  for c in $CHECKS; do
    [[ " $MODULES " == *" $c "* ]] || { echo "FEHLER: unbekanntes Prüfmodul $c (vorhanden: $MODULES)"; ok=1; }
  done
  if [[ " $CHECKS " == *" docker "* ]]; then
    [[ -S $DOCKER_SOCKET ]] && echo "OK: Docker-Socket $DOCKER_SOCKET" || echo "HINWEIS: Docker-Socket $DOCKER_SOCKET fehlt"
  fi
  echo "Webhooks: $(jq -r 'map("\(.name // "?") (\(.type // "json"))") | join(", ")' <<<"$WEBHOOKS" 2>/dev/null)"
  echo "Endpoints: $(jq -r 'map(.name // .url) | join(", ")' <<<"$ENDPOINTS" 2>/dev/null)"
  (( ok == 0 )) && echo "Konfiguration in Ordnung."
  return "$ok"
}

# Formatiert status.json als farbige Übersichtstabelle für das Terminal
print_table() {
  local file=$1 mode=$2 age=$3 c_reset="" c_lvl tty=0 lvl id st msg
  [[ -t 1 ]] && tty=1 && c_reset=$'\e[0m'
  jq -r --argjson age "$age" '
    "Monitor auf \(.host) · Gesamt: \(.level) · Stand vor \($age) s · Durchlauf \(.cycle_ms) ms",
    "CPU \(.system.cpu_percent) % · RAM \(.system.mem_percent) % · Load \(.system.load1) \(.system.load5) \(.system.load15) (\(.system.cores) Kerne) · Uptime \(.system.uptime)",
    "Container: \(.containers.running) von \(.containers.total) laufen · INFO \(.counts.INFO) · WARNING \(.counts.WARNING) · ERROR \(.counts.ERROR) · CRITICAL \(.counts.CRITICAL)",
    ""' "$file"
  printf '%-9s %-36s %-14s %s\n' STUFE PRÜFUNG ZUSTAND MELDUNG
  while IFS=$'\t' read -r lvl id st msg; do
    c_lvl=""
    if (( tty )); then
      case $lvl in WARNING) c_lvl=$'\e[33m' ;; ERROR) c_lvl=$'\e[31m' ;; CRITICAL) c_lvl=$'\e[1;31m' ;; *) c_lvl=$'\e[32m' ;; esac
    fi
    printf '%s%-9s%s %-36s %-14s %s\n' "$c_lvl" "$lvl" "$c_reset" "${id:0:36}" "${st:0:14}" "$msg"
  done < <(jq -r --arg mode "$mode" \
             '.checks[] | select($mode != "problems" or .level != "INFO") | [.level, .id, .status, .message] | @tsv' "$file")
}

# === 10. Einrichtung & Verwaltung (idempotent, nur als root) ===

say()       { printf '  %s\n' "$*"; }
need_root() { (( EUID == 0 )) || die "bitte als root ausführen (sudo)"; }

# Liest alle erlaubten Konfigurationsnamen direkt aus dem Kopf dieses Skripts
known_keys() {
  sed -n '/^#  KONFIGURATION/,/^#  Ab hier keine Konfiguration/p' "$SELF" |
    sed -n 's/^\([A-Z_][A-Z0-9_]*\)=.*/\1/p'
}
is_known_key() { known_keys | grep -qx "$1"; }

# Schreibt oder ersetzt einen Konfigurationswert atomar (auch bei mehrzeiligem JSON)
set_value() {
  local key=$1 value=$2 quoted tmp
  [[ $key =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "ungültiger Name: $key"
  is_known_key "$key" || die "unbekannte Option: $key"
  quoted="'${value//\'/\'\\\'\'}'"
  install -d -m 0700 "${MONITOR_CONF%/*}"
  [[ -e $MONITOR_CONF ]] || install -m 0600 /dev/null "$MONITOR_CONF"
  tmp=$(mktemp "$MONITOR_CONF.XXXXXX")
  awk -v k="$key" -v line="$key=$quoted" '
    BEGIN { done = 0 }
    $0 ~ "^" k "=" { if (!done) { print line; done = 1 }; skip = ($0 ~ /^[A-Z0-9_]+='\''[^'\'']*$/); next }
    skip { if ($0 ~ /'\''$/) skip = 0; next }
    { print }
    END { if (!done) print line }' "$MONITOR_CONF" >"$tmp"
  chmod 0600 "$tmp"; mv -f "$tmp" "$MONITOR_CONF"
  printf -v "$key" '%s' "$value"
  say "$key gesetzt"
}

# Erzeugt die gehärtete systemd-Unit (schreibgeschütztes System, nur /run/monitor im RAM)
write_unit() {
  cat >"$UNIT_FILE" <<EOF
[Unit]
Description=Monitoring für Container, Dienste, Ressourcen und Schnittstellen (#14)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$INSTALL_BIN run
Environment=MONITOR_CONF=$MONITOR_CONF
Restart=always
RestartSec=5
RuntimeDirectory=monitor
RuntimeDirectoryMode=0755
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Nice=5
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 "$UNIT_FILE"
}

# Installiert Skript, Konfiguration und systemd-Dienst idempotent
cmd_install() {
  need_root
  local config="" start=1 missing=() p
  while (( $# )); do
    case $1 in
      --config) config=${2:?Datei fehlt}; shift 2 ;;
      --no-start) start=0; shift ;;
      *) die "unbekannte Option: $1" ;;
    esac
  done

  echo "Monitoring installieren"
  for p in curl jq; do command -v "$p" >/dev/null || missing+=("$p"); done
  if (( ${#missing[@]} )); then
    say "installiere Pakete: ${missing[*]}"
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" >/dev/null || die "apt-get fehlgeschlagen"
  fi
  if [[ $SELF != "$INSTALL_BIN" ]]; then
    say "Programm nach $INSTALL_BIN"
    rm -f "$INSTALL_BIN"
    install -m 0755 -o root -g root "$SELF" "$INSTALL_BIN"
  fi
  install -d -m 0700 "${MONITOR_CONF%/*}"
  if [[ -n $config ]]; then
    say "Konfiguration aus $config"
    if [[ $(readlink -f "$config") == "$(readlink -f "$MONITOR_CONF")" ]]; then
      chown root:root "$MONITOR_CONF" && chmod 0600 "$MONITOR_CONF"
    else
      install -m 0600 -o root -g root "$config" "$MONITOR_CONF"
    fi
  elif [[ ! -e $MONITOR_CONF ]]; then
    say "leere Konfiguration $MONITOR_CONF (Standardwerte aus dem Skript)"
    install -m 0600 -o root -g root /dev/null "$MONITOR_CONF"
  else
    say "vorhandene Konfiguration bleibt: $MONITOR_CONF"
  fi

  say "systemd-Unit $UNIT_FILE"
  write_unit
  systemctl daemon-reload
  echo "Konfiguration prüfen"
  MONITOR_CONF=$MONITOR_CONF "$INSTALL_BIN" validate | sed 's/^/  /'
  if (( start )); then
    systemctl enable --quiet monitor.service
    systemctl restart monitor.service
    say "monitor.service: $(systemctl is-active monitor.service)"
  fi
  echo "Fertig. Zustand ansehen: monitor status"
}

# Startet den Dienst nur neu, wenn er bereits läuft
restart_if_running() {
  if systemctl is-active --quiet monitor.service 2>/dev/null; then
    systemctl restart monitor.service
    say "monitor.service neu gestartet"
  fi
}

# Ändert eine oder mehrere Optionen in monitor.conf
cmd_set() {
  need_root
  (( $# )) || die "Aufruf: monitor set NAME=WERT ..."
  local kv
  for kv in "$@"; do
    [[ $kv == *=* ]] || die "erwartet NAME=WERT, bekommen: $kv"
    set_value "${kv%%=*}" "${kv#*=}"
  done
  restart_if_running
}

# Fügt einen Discord- oder JSON-Webhook hinzu (oder ersetzt ihn anhand des Namens)
cmd_webhook_add() {
  need_root
  local name=${1:?Name fehlt} type=${2:?Typ fehlt (discord oder json)} url=${3:?URL fehlt}
  local events=${4:-change,report} min=${5:-WARNING}
  [[ $type == discord || $type == json ]] || die "Typ muss discord oder json sein"
  jq -e 'type == "array"' <<<"$WEBHOOKS" >/dev/null 2>&1 || die "WEBHOOKS ist keine JSON-Liste"
  set_value WEBHOOKS "$(jq -c --arg n "$name" --arg t "$type" --arg u "$url" --arg e "$events" --arg m "$min" \
    'map(select(.name != $n)) + [{name:$n, type:$t, url:$u, events:($e | split(",")), min_level:$m}]' <<<"$WEBHOOKS")"
  restart_if_running
}

# Entfernt einen Webhook anhand seines Namens
cmd_webhook_remove() {
  need_root
  set_value WEBHOOKS "$(jq -c --arg n "${1:?Name fehlt}" 'map(select(.name != $n))' <<<"$WEBHOOKS")"
  restart_if_running
}

# Zeigt die aktive Konfiguration mit gekürzten Webhook-URLs und Headern an
cmd_show() {
  need_root
  local key
  while IFS= read -r key; do
    case $key in
      WEBHOOKS)  printf 'WEBHOOKS=%s\n' "$(jq -c 'map(.url |= (.[0:30] + "…"))' <<<"$WEBHOOKS")" ;;
      ENDPOINTS) printf 'ENDPOINTS=%s\n' "$(jq -c 'map(if .headers then .headers |= map_values(.[0:8] + "…") else . end)' <<<"$ENDPOINTS")" ;;
      *)         printf '%s=%s\n' "$key" "${!key}" ;;
    esac
  done < <(known_keys)
}

# Entfernt Dienst, Programm und Laufzeitordner (mit --purge auch die Konfiguration)
cmd_uninstall() {
  need_root
  systemctl disable --now monitor.service 2>/dev/null || true
  rm -f "$UNIT_FILE" "$INSTALL_BIN"
  systemctl daemon-reload
  rm -rf "$RUN_DIR"
  if [[ ${1:-} == --purge ]]; then rm -rf "${MONITOR_CONF%/*}"; say "Konfiguration gelöscht"
  else say "Konfiguration bleibt in ${MONITOR_CONF%/*} (löschen mit --purge)"; fi
  echo "Monitoring entfernt."
}

# === 11. CLI-Hilfe und Einstiegspunkt ===

# Gibt die Befehlsübersicht aus
usage() {
  cat <<EOF
monitor $VERSION – Monitoring für Container, Dienste, Ressourcen und Schnittstellen

Betrieb:
  status [--json|--problems]   Zustand aus dem laufenden Dienst anzeigen
  check  [--json]              jetzt einmal prüfen und anzeigen, ohne Meldungen
  run                          Dauerbetrieb (startet systemd: monitor.service)
  report                       Bericht jetzt an die Webhooks senden
  test-webhook [NAME]          Testmeldung an alle oder einen Webhook senden
  validate                     Konfiguration und Voraussetzungen prüfen

Einrichtung (als root, beliebig oft ausführbar):
  install [--config DATEI] [--no-start]     installieren, Dienst starten
  set NAME=WERT ...                         Wert in der Konfiguration setzen
  webhook-add NAME TYP URL [EVENTS] [STUFE] Webhook (discord|json) hinzufügen
  webhook-remove NAME
  show                                      Konfiguration anzeigen (Geheimnisse gekürzt)
  uninstall [--purge]                       entfernen (--purge: auch Konfiguration)

Rückgabewert von status und check: 0 INFO, 1 WARNING, 2 ERROR, 3 CRITICAL,
4 kein aktueller Zustand (Dienst läuft nicht).

Konfiguration: $MONITOR_CONF   Laufzeitdaten (RAM): $RUN_DIR
EOF
}

# Verteilt den Unterbefehl an die zuständige Funktion
main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    run)                  cmd_run "$@" ;;
    status)               cmd_status "$@" ;;
    check)                cmd_check "$@" ;;
    report)               cmd_report "$@" ;;
    test-webhook)         cmd_test_webhook "$@" ;;
    validate)             cmd_validate "$@" ;;
    install)              cmd_install "$@" ;;
    set)                  cmd_set "$@" ;;
    webhook-add)          cmd_webhook_add "$@" ;;
    webhook-remove)       cmd_webhook_remove "$@" ;;
    show)                 cmd_show "$@" ;;
    uninstall)            cmd_uninstall "$@" ;;
    _collect)             collect "$@" ;;
    version|-v|--version) echo "monitor $VERSION" ;;
    help|-h|--help)       usage ;;
    *)                    usage >&2; exit 64 ;;
  esac
}

main "$@"
